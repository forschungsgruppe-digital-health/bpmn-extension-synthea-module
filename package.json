{
  "name": "bpmn-js-synthea-extension",
  "version": "0.1.0",
  "private": true,
  "description": "bpmn.io extension and converter to model patient pathways in BPMN and generate Synthea modules",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forschungsgruppe-digital-health/bpmn-extension-synthea-module.git"
  },
  "homepage": "https://github.com/forschungsgruppe-digital-health/bpmn-extension-synthea-module#readme",
  "bugs": {
    "url": "https://github.com/forschungsgruppe-digital-health/bpmn-extension-synthea-module/issues"
  },
  "type": "module",
  "license": "MIT",
  "main": "./extension/src/index.js",
  "exports": {
    ".": "./extension/src/index.js",
    "./model": "./extension/model/synthea.json",
    "./xsd": "./extension/model/synthea.xsd",
    "./converter": "./extension/src/converter/convert.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "bpmn2gmf": "./extension/src/converter/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "extension/lint/bpmnlint-plugin-synthea",
    "demo"
  ],
  "files": [
    "extension/src",
    "extension/model",
    "extension/README.md"
  ],
  "scripts": {
    "site": "node tools/build-site.mjs / site",
    "lint:valid": "bpmnlint \"examples/valid/**/*.bpmn\" \"examples/lung-cancer/*.bpmn\"",
    "lint:invalid": "bpmnlint \"examples/invalid/**/*.bpmn\"",
    "roundtrip": "node tools/moddle-roundtrip.mjs",
    "xsd": "bash tools/validate-xsd.sh",
    "xsd:gen": "node tools/moddle-to-xsd.mjs",
    "xsd:gen:check": "node tools/moddle-to-xsd.mjs --check",
    "api:gen": "node tools/gen-extension-api.mjs",
    "api:gen:check": "node tools/gen-extension-api.mjs --check",
    "xsd:ext": "node tools/validate-xsd-ext.mjs",
    "conventions": "node tools/check-package-conventions.mjs",
    "jsdoc:check": "node tools/check-jsdoc.mjs",
    "test:consumer": "node tools/test-consumer.mjs",
    "check:attributes": "node tools/check-attribute-usage.mjs",
    "bpmn2gmf": "node extension/src/converter/cli.mjs",
    "test": "node --test \"extension/test/*.test.mjs\"",
    "convert:site": "node tools/build-converter-site.mjs lung-cancer --out-dir demo/dist/modules",
    "convert:check": "node extension/src/converter/cli.mjs examples/lung-cancer --check --strict",
    "synthea:smoke": "node tools/synthea-smoke.mjs",
    "schema:gen": "node tools/gen-module-schema.mjs",
    "schema:gen:check": "node tools/gen-module-schema.mjs --check",
    "validate:diagram": "npm run lint:valid && npm run roundtrip && npm run xsd && npm run xsd:gen:check && npm run xsd:ext && npm run api:gen:check",
    "validate:convert": "npm run schema:gen:check && npm test && npm run convert:check",
    "validate": "npm run validate:diagram && npm run conventions && npm run jsdoc:check && npm run validate:convert",
    "demo": "npm --prefix demo run dev",
    "check:pages": "node tools/build-site.mjs /bpmn-extension-synthea-module/ site",
    "demo:build": "npm --prefix demo run build"
  },
  "peerDependencies": {
    "bpmn-js": ">=17",
    "diagram-js": ">=14",
    "@bpmn-io/properties-panel": ">=3",
    "bpmn-js-properties-panel": ">=5"
  },
  "peerDependenciesMeta": {
    "@bpmn-io/properties-panel": {
      "optional": true
    },
    "bpmn-js-properties-panel": {
      "optional": true
    }
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "esbuild": "^0.25.12",
    "bpmnlint": "^11.0.0",
    "bpmn-js-properties-panel": "^5.30.0"
  },
  "dependencies": {
    "bpmn-moddle": "^9.0.1"
  }
}
