{
  "name": "bpmn-js-synthea-extension",
  "version": "0.1.0",
  "description": "bpmn.io extension and converter to model patient pathways in BPMN and generate Synthea modules",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forschungsgruppe-digital-health/bpmn-extension-synthea-module.git"
  },
  "homepage": "https://github.com/forschungsgruppe-digital-health/bpmn-extension-synthea-module#readme",
  "bugs": {
    "url": "https://github.com/forschungsgruppe-digital-health/bpmn-extension-synthea-module/issues"
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "extension/lint/bpmnlint-plugin-synthea",
    "demo"
  ],
  "files": [
    "extension"
  ],
  "scripts": {
    "lint:valid": "bpmnlint \"examples/valid/**/*.bpmn\" \"lung-cancer/*.bpmn\"",
    "lint:invalid": "bpmnlint \"examples/invalid/**/*.bpmn\"",
    "roundtrip": "node tools/moddle-roundtrip.mjs",
    "xsd": "bash tools/validate-xsd.sh",
    "xsd:gen": "node tools/moddle-to-xsd.mjs",
    "xsd:gen:check": "node tools/moddle-to-xsd.mjs --check",
    "xsd:ext": "node tools/validate-xsd-ext.mjs",
    "conventions": "node tools/check-package-conventions.mjs",
    "check:attributes": "node tools/check-attribute-usage.mjs",
    "bpmn2gmf": "node tools/bpmn2gmf/cli.mjs",
    "test:bpmn2gmf": "node --test \"tools/bpmn2gmf/test/*.test.mjs\"",
    "convert:site": "node tools/build-converter-site.mjs lung-cancer --out-dir demo/dist/modules",
    "convert:check": "node tools/bpmn2gmf/cli.mjs lung-cancer --check --strict",
    "compare:upstream": "node tools/bpmn2gmf/compare-upstream.mjs",
    "compare:structure": "node tools/bpmn2gmf/compare-structure.mjs",
    "synthea:smoke": "node tools/synthea-smoke.mjs",
    "schema:gen": "node tools/bpmn2gmf/gen-schema.mjs",
    "schema:gen:check": "node tools/bpmn2gmf/gen-schema.mjs --check",
    "validate": "npm run lint:valid && npm run roundtrip && npm run xsd && npm run xsd:gen:check && npm run xsd:ext && npm run conventions && npm run schema:gen:check && npm run test:bpmn2gmf && npm run convert:check && npm run compare:structure",
    "demo": "npm --prefix demo run dev",
    "check:pages": "BASE_PATH=/bpmn-extension-synthea-module/ npm --prefix demo run build && npm run convert:site && node tools/check-pages-build.mjs demo/dist /bpmn-extension-synthea-module/",
    "demo:build": "npm --prefix demo run build"
  },
  "peerDependencies": {
    "bpmn-js": ">=17",
    "diagram-js": ">=14",
    "@bpmn-io/properties-panel": ">=3",
    "bpmn-js-properties-panel": ">=5"
  },
  "peerDependenciesMeta": {
    "@bpmn-io/properties-panel": { "optional": true },
    "bpmn-js-properties-panel": { "optional": true }
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "bpmn-moddle": "^9.0.1",
    "esbuild": "^0.25.12",
    "bpmnlint": "^11.0.0",
    "bpmn-js-properties-panel": "^5.30.0"
  }
}
