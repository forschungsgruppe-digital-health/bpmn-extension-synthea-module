<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:synthea="https://forschungsgruppe-digital-health.github.io/schema/synthea/1.0"
                   xmlns:fhirmap="https://forschungsgruppe-digital-health.github.io/schema/fhirmap/1.0"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="Process_1" isExecutable="false">

    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- probability-sum-valid: two fixed probabilities summing to 1.4 -->
    <bpmn:task id="Task_Branch" name="Branch">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_A" name="A">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Simple" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_A_Out</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_B" name="B">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Simple" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_B_Out</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_A">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Terminal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A_Out</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_B">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Terminal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B_Out</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Branch" />
    <bpmn:sequenceFlow id="Flow_A_Out" sourceRef="Task_A" targetRef="EndEvent_A" />
    <bpmn:sequenceFlow id="Flow_B_Out" sourceRef="Task_B" targetRef="EndEvent_B" />

    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Task_Branch" targetRef="Task_A">
      <bpmn:extensionElements>
        <synthea:ProbabilityConfig probability="0.8" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_Branch" targetRef="Task_B">
      <bpmn:extensionElements>
        <synthea:ProbabilityConfig probability="0.6" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <!-- negate-requires-condition: negate=true on an empty Condition -->
    <bpmn:task id="Task_CondSource" name="Cond source">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Simple" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Cond_Bad</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Cond">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Terminal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Cond_Bad</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Cond_Bad" sourceRef="Task_CondSource" targetRef="EndEvent_Cond">
      <bpmn:extensionElements>
        <synthea:ConditionConfig>
          <synthea:condition negate="true" />
        </synthea:ConditionConfig>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <!-- state-type-fhirmap-consistent: stateType="Procedure" but
         fhirmap:resourceType is absent -->
    <bpmn:task id="Task_Procedure_Bad" name="Bad procedure mapping">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Procedure" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- guard-state-requires-guard-config: stateType="Guard" with no GuardConfig at all -->
    <bpmn:exclusiveGateway id="Gateway_Guard_NoConfig" name="Guard (missing GuardConfig)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Guard" />
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>

    <!-- guard-allow-requires-condition: GuardConfig present but allow is empty -->
    <bpmn:exclusiveGateway id="Gateway_Guard_EmptyAllow" name="Guard (empty allow)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Guard" />
        <synthea:GuardConfig>
          <synthea:allow />
        </synthea:GuardConfig>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>

    <!-- callsubmodule-requires-submodule-config: stateType="CallSubmodule" with no submodule target -->
    <bpmn:callActivity id="CallActivity_NoSubmodule" name="Call submodule (missing target)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="CallSubmodule" />
      </bpmn:extensionElements>
    </bpmn:callActivity>

    <!-- delay-requires-shape: stateType="Delay" with no DelayConfig -->
    <bpmn:intermediateCatchEvent id="Delay_NoShape" name="Delay (missing shape)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Delay" />
      </bpmn:extensionElements>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- delay-distribution-kind-requires-distribution-shape: distributionKind set
         while delayShape is "EXACT", not "DISTRIBUTION" -->
    <bpmn:intermediateCatchEvent id="Delay_BadDistributionKind" name="Delay (bad distribution kind)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Delay" />
        <synthea:DelayConfig delayShape="EXACT" distributionKind="GAUSSIAN" delayValue="10" delayUnit="days" />
      </bpmn:extensionElements>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- encounter-reference-requires-condition-or-allergy-context: targetEncounter
         on a ConditionEnd state (only ConditionOnset/AllergyOnset are valid) -->
    <bpmn:intermediateCatchEvent id="ConditionEnd_BadReference" name="Condition end (bad reference)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="ConditionEnd" />
        <fhirmap:resourceMapping resourceType="Condition" />
        <synthea:EncounterReference targetEncounter="Encounter_1" />
      </bpmn:extensionElements>
    </bpmn:intermediateCatchEvent>

    <!-- wellness-consistent-within-encounter: two states sharing one encounterId
         disagree on wellness -->
    <bpmn:task id="EncounterB_Member1_Bad" name="Encounter B member 1 (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
        <synthea:SetAttributeConfig attribute="last_encounter_note" />
        <synthea:EncounterContext requiresEncounterContext="true" encounterId="Encounter_B" wellness="true" />
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="EncounterB_Member2_Bad" name="Encounter B member 2 (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
        <synthea:SetAttributeConfig attribute="last_encounter_note" />
        <synthea:EncounterContext requiresEncounterContext="true" encounterId="Encounter_B" wellness="false" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- counter-requires-action: stateType="Counter" with no CounterConfig at all -->
    <bpmn:task id="Task_Counter_NoConfig" name="Counter (missing config)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Counter" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- set-attribute-requires-attribute: stateType="SetAttribute" with no SetAttributeConfig -->
    <bpmn:task id="Task_SetAttribute_NoConfig" name="Set attribute (missing config)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- assign-to-attribute-requires-valid-state: attribute set on a Procedure state
         (not one of ConditionOnset/AllergyOnset/MedicationOrder/CarePlanStart/Device) -->
    <bpmn:task id="Procedure_AssignBad" name="Procedure with assign (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Procedure" />
        <fhirmap:resourceMapping resourceType="Procedure" />
        <synthea:AssignToAttributeConfig attribute="lung_cancer_diagnosis_date" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- delay-range-requires-high-value: delayShape="RANGE" with no delayValueHigh -->
    <bpmn:intermediateCatchEvent id="Delay_Range_NoHigh" name="Delay range (missing high)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Delay" />
        <synthea:DelayConfig delayShape="RANGE" delayValue="3" delayUnit="months" />
      </bpmn:extensionElements>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

  </bpmn:process>
</bpmn:definitions>
