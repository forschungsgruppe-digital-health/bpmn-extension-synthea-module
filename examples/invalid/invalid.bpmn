<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:synthea="https://forschungsgruppe-digital-health.github.io/schema/synthea/1.0"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="Process_1" isExecutable="false">

    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- probability-sum-valid: two fixed probabilities summing to 1.4 -->
    <bpmn:task id="Task_Branch" name="Branch">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_A" name="A">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Simple" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_A_Out</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_B" name="B">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Simple" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_B_Out</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_A">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Terminal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A_Out</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_B">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Terminal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B_Out</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Branch" />
    <bpmn:sequenceFlow id="Flow_A_Out" sourceRef="Task_A" targetRef="EndEvent_A" />
    <bpmn:sequenceFlow id="Flow_B_Out" sourceRef="Task_B" targetRef="EndEvent_B" />

    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Task_Branch" targetRef="Task_A">
      <bpmn:extensionElements>
        <synthea:ProbabilityConfig probability="0.8" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_Branch" targetRef="Task_B">
      <bpmn:extensionElements>
        <synthea:ProbabilityConfig probability="0.6" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <!-- negate-requires-condition: negate=true on an empty Condition -->
    <bpmn:task id="Task_CondSource" name="Cond source">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Simple" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Cond_Bad</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Cond">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Terminal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Cond_Bad</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Cond_Bad" sourceRef="Task_CondSource" targetRef="EndEvent_Cond">
      <bpmn:extensionElements>
        <synthea:ConditionConfig>
          <synthea:condition negate="true" />
        </synthea:ConditionConfig>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <!-- guard-state-requires-guard-config: stateType="Guard" with no GuardConfig at all -->
    <bpmn:exclusiveGateway id="Gateway_Guard_NoConfig" name="Guard (missing GuardConfig)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Guard" />
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>

    <!-- guard-allow-requires-condition: GuardConfig present but allow is empty -->
    <bpmn:exclusiveGateway id="Gateway_Guard_EmptyAllow" name="Guard (empty allow)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Guard" />
        <synthea:GuardConfig>
          <synthea:allow />
        </synthea:GuardConfig>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>

    <!-- guard-allow-requires-condition: And combinator with no conditions to combine -->
    <bpmn:exclusiveGateway id="Gateway_Guard_EmptyAnd" name="Guard (empty And)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Guard" />
        <synthea:GuardConfig>
          <synthea:allow conditionType="And" />
        </synthea:GuardConfig>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>

    <!-- callsubmodule-requires-submodule-config: stateType="CallSubmodule" with no submodule target -->
    <bpmn:callActivity id="CallActivity_NoSubmodule" name="Call submodule (missing target)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="CallSubmodule" />
      </bpmn:extensionElements>
    </bpmn:callActivity>

    <!-- delay-requires-shape: stateType="Delay" with no DelayConfig -->
    <bpmn:intermediateCatchEvent id="Delay_NoShape" name="Delay (missing shape)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Delay" />
      </bpmn:extensionElements>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- encounter-reference-requires-condition-or-allergy-context: targetEncounter
         on a ConditionEnd state (only ConditionOnset/AllergyOnset are valid) -->
    <bpmn:intermediateCatchEvent id="ConditionEnd_BadReference" name="Condition end (bad reference)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="ConditionEnd" />
        <synthea:EncounterReference targetEncounter="Encounter_1" />
      </bpmn:extensionElements>
    </bpmn:intermediateCatchEvent>

    <!-- wellness-consistent-within-encounter: two states sharing one encounterId
         disagree on wellness -->
    <bpmn:task id="EncounterB_Member1_Bad" name="Encounter B member 1 (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
        <synthea:SetAttributeConfig attribute="last_encounter_note" />
        <synthea:EncounterContext requiresEncounterContext="true" encounterId="Encounter_B" wellness="true" />
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="EncounterB_Member2_Bad" name="Encounter B member 2 (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
        <synthea:SetAttributeConfig attribute="last_encounter_note" />
        <synthea:EncounterContext requiresEncounterContext="true" encounterId="Encounter_B" wellness="false" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- encounter-class-consistent-within-encounter: two states sharing one encounterId
         disagree on encounterClass -->
    <bpmn:task id="EncounterD_Member1_Bad" name="Encounter D member 1 (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
        <synthea:SetAttributeConfig attribute="last_encounter_note" />
        <synthea:EncounterContext requiresEncounterContext="true" encounterId="Encounter_D" wellness="false" encounterClass="emergency" />
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="EncounterD_Member2_Bad" name="Encounter D member 2 (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
        <synthea:SetAttributeConfig attribute="last_encounter_note" />
        <synthea:EncounterContext requiresEncounterContext="true" encounterId="Encounter_D" wellness="false" encounterClass="inpatient" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- counter-requires-action: stateType="Counter" with no CounterConfig at all -->
    <bpmn:task id="Task_Counter_NoConfig" name="Counter (missing config)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Counter" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- set-attribute-requires-attribute: stateType="SetAttribute" with no SetAttributeConfig -->
    <bpmn:task id="Task_SetAttribute_NoConfig" name="Set attribute (missing config)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- attribute-name-lower-snake-case: attribute name is not lower_snake_case -->
    <bpmn:task id="Task_SetAttribute_BadName" name="Set attribute (bad name)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
        <synthea:SetAttributeConfig attribute="Lung Cancer Type" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- assign-to-attribute-requires-valid-state: attribute set on a Procedure state
         (not one of ConditionOnset/AllergyOnset/MedicationOrder/CarePlanStart/Device) -->
    <bpmn:task id="Procedure_AssignBad" name="Procedure with assign (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Procedure" />
        <synthea:AssignToAttributeConfig attribute="lung_cancer_diagnosis_date" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- delay-range-requires-high-value: delayShape="RANGE" with no delayValueHigh -->
    <bpmn:intermediateCatchEvent id="Delay_Range_NoHigh" name="Delay range (missing high)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Delay" />
        <synthea:DelayConfig delayShape="RANGE" delayValue="3" delayUnit="months" />
      </bpmn:extensionElements>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- referenced-by-attribute-requires-valid-state: attribute set on a Procedure state
         (not one of ConditionEnd/AllergyEnd/MedicationEnd/CarePlanEnd/DeviceEnd/Death) -->
    <bpmn:task id="Procedure_ReferencedBad" name="Procedure with referenced-by (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Procedure" />
        <synthea:ReferencedByAttributeConfig attribute="lung_cancer_diagnosis_date" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- referenced-by-attribute-matches-assign: attribute has no corresponding
         assignToAttributeConfig anywhere in this process (valid state type,
         so this element only trips the new rule, not the state-type one) -->
    <bpmn:endEvent id="ConditionEnd_ReferencedUnmatched" name="Condition end with unmatched referenced-by (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="ConditionEnd" />
        <synthea:ReferencedByAttributeConfig attribute="never_assigned_attribute" />
      </bpmn:extensionElements>
    </bpmn:endEvent>

    <!-- encounter-code-complete-and-consistent: encounterCode without system and display -->
    <bpmn:task id="Task_EncounterCodePartial" name="Encounter code incomplete (bad)">
      <bpmn:extensionElements>
        <synthea:EncounterContext requiresEncounterContext="true" encounterId="Encounter_CodePartial" wellness="false" encounterClass="inpatient" encounterCode="185347001" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- value-range-requires-high-value: RANGE without valueHigh -->
    <bpmn:task id="Task_ValueRangeNoHigh" name="Observation range without high (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Observation" />
        <synthea:ValueConfig valueShape="RANGE" value="4" unit="{score}" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- careplan-activity-requires-code-and-display: activity with a code but no display -->
    <bpmn:task id="Task_CarePlanActivityPartial" name="Care plan activity incomplete (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="CarePlanStart" />
        <synthea:CarePlanActivity code="133918004" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- state-code-complete: a code with no codeSystem and no codeDisplay -->
    <bpmn:task id="Task_CodeIncomplete" name="Code incomplete (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Procedure" code="399208008" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- state-code-complete: a Procedure with a LOINC code (a procedure takes SNOMED CT) -->
    <bpmn:task id="Task_CodeWrongSystem" name="Code in the wrong system (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Procedure" codeSystem="http://loinc.org" code="1234-5" codeDisplay="x" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- gateway-branches-require-condition-or-probability: two outgoing flows, neither has a
         synthea:conditionConfig or synthea:probabilityConfig -->
    <bpmn:exclusiveGateway id="Gateway_BranchesNoConfig" name="Branches (no condition)" />
    <bpmn:sequenceFlow id="Flow_BranchNoConfig_A" sourceRef="Gateway_BranchesNoConfig" targetRef="Task_Counter_NoConfig" />
    <bpmn:sequenceFlow id="Flow_BranchNoConfig_B" sourceRef="Gateway_BranchesNoConfig" targetRef="Task_SetAttribute_NoConfig" />

    <!-- inclusive-branches-require-condition-or-probability: every branch is decided on its own, so the
         second flow needs a condition or probability too (unlike an exclusive gateway there is no fallback) -->
    <bpmn:inclusiveGateway id="Gateway_InclusiveNoConfig" name="Inclusive (branch without probability)" />
    <bpmn:sequenceFlow id="Flow_InclusiveNoConfig_A" sourceRef="Gateway_InclusiveNoConfig" targetRef="Task_Counter_NoConfig">
      <bpmn:extensionElements>
        <synthea:ProbabilityConfig probabilityKind="FIXED" probability="0.4" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InclusiveNoConfig_B" sourceRef="Gateway_InclusiveNoConfig" targetRef="Task_SetAttribute_NoConfig" />

  
    <!-- alternatives-not-mixed: a fixed value and a copy of another attribute on one Set Attribute -->
    <bpmn:task id="Task_SetTwoWays" name="Set two ways (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
        <synthea:SetAttributeConfig attribute="x" value="3" valueAttribute="y" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- alternatives-not-mixed: wellness together with an encounter class -->
    <bpmn:task id="Task_WellnessAndClass" name="Wellness and class (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Procedure" />
        <synthea:EncounterContext requiresEncounterContext="true" encounterId="E_mixed" wellness="true" encounterClass="inpatient" />
      </bpmn:extensionElements>
    </bpmn:task>
  
    <!-- alternatives-not-mixed: delayValueHigh on an exact delay -->
    <bpmn:intermediateCatchEvent id="Event_DelayHighOnExact" name="Delay high on exact (bad)">
      <bpmn:extensionElements>
        <synthea:DelayConfig delayShape="EXACT" delayValue="1" delayValueHigh="3" delayUnit="days" />
      </bpmn:extensionElements>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- alternatives-not-mixed: valueHigh on an exact value -->
    <bpmn:task id="Task_ValueHighOnExact" name="Value high on exact (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Observation" />
        <synthea:ValueConfig valueShape="EXACT" value="1" valueHigh="3" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- alternatives-not-mixed: an end state with a code and a reference to an attribute -->
    <bpmn:task id="Task_ReferenceAndCode" name="Reference and code (bad)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="ConditionEnd" codeSystem="http://snomed.info/sct" code="1" codeDisplay="x" />
        <synthea:ReferencedByAttributeConfig attribute="dx" />
      </bpmn:extensionElements>
    </bpmn:task>
  </bpmn:process>
</bpmn:definitions>
