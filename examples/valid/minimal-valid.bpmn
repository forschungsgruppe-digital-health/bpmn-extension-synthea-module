<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:synthea="https://forschungsgruppe-digital-health.github.io/schema/synthea/1.0"
                   id="Definitions_valid" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="Process_1" isExecutable="false">

    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- probability-sum-valid: two fixed probabilities that sum to exactly 1.0 -->
    <bpmn:task id="Task_Branch" name="Branch">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Simple" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:task>

    <!-- state-code-complete: a code with system, code and display text, in a system the state type accepts -->
    <bpmn:task id="Task_A" name="A">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Procedure" codeSystem="http://snomed.info/sct" code="399208008" codeDisplay="Plain X-ray of chest (procedure)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_A_Out</bpmn:outgoing>
    </bpmn:task>

    <!-- set-attribute-requires-attribute: SetAttributeConfig has an attribute name -->
    <bpmn:task id="Task_B" name="B">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
        <synthea:SetAttributeConfig attribute="smoker" value="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_B_Out</bpmn:outgoing>
    </bpmn:task>

    <!-- negate-requires-condition: negate="true" with conditionType/operator set is valid -->
    <bpmn:endEvent id="EndEvent_A">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Terminal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A_Out</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_B">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Terminal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B_Out</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Branch" />

    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Task_Branch" targetRef="Task_A">
      <bpmn:extensionElements>
        <synthea:ProbabilityConfig probability="0.6" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_Branch" targetRef="Task_B">
      <bpmn:extensionElements>
        <synthea:ProbabilityConfig probability="0.4" />
        <synthea:ConditionConfig>
          <synthea:condition conditionType="Attribute" attribute="lung_cancer" operator="==" value="true" negate="true" />
        </synthea:ConditionConfig>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_A_Out" sourceRef="Task_A" targetRef="EndEvent_A" />
    <bpmn:sequenceFlow id="Flow_B_Out" sourceRef="Task_B" targetRef="EndEvent_B" />

    <!-- guard-state-requires-guard-config + guard-allow-requires-condition:
         stateType="Guard" with a complete GuardConfig.allow -->
    <bpmn:exclusiveGateway id="Gateway_Guard_Good" name="Guard (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Guard" />
        <synthea:GuardConfig>
          <synthea:allow conditionType="Attribute" attribute="ready_for_op" operator="==" value="true" />
        </synthea:GuardConfig>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>

    <!-- Age_Guard example (see docs/implicit-rules.md Table A): a Guard using
         the Age conditionType instead of Attribute, waiting until the
         patient turns 65 -->
    <bpmn:exclusiveGateway id="Gateway_AgeGuard_Good" name="Age guard (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Guard" />
        <synthea:GuardConfig>
          <synthea:allow conditionType="Age" operator=">=" quantity="65" unit="years" />
        </synthea:GuardConfig>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>

    <!-- And combinator: nested conditions (age >= 45 AND gender == F),
         verified against moddle's own export before writing this by hand -->
    <bpmn:exclusiveGateway id="Gateway_AndGuard_Good" name="And guard (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Guard" />
        <synthea:GuardConfig>
          <synthea:allow conditionType="And">
            <synthea:condition conditionType="Age" operator="&#62;=" quantity="45" unit="years" />
            <synthea:condition conditionType="Gender" gender="F" />
          </synthea:allow>
        </synthea:GuardConfig>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>

    <!-- Gender conditionType on a ConditionConfig (sequence flow) -->
    <bpmn:task id="Task_GenderBranch_Good" name="Gender branch source (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Simple" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_GenderBranch</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_GenderBranch">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Terminal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GenderBranch</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_GenderBranch" sourceRef="Task_GenderBranch_Good" targetRef="EndEvent_GenderBranch">
      <bpmn:extensionElements>
        <synthea:ConditionConfig>
          <synthea:condition conditionType="Gender" gender="F" />
        </synthea:ConditionConfig>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <!-- callsubmodule-requires-submodule-config: stateType="CallSubmodule" with a submodule target -->
    <bpmn:callActivity id="CallActivity_Good" name="Call submodule (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="CallSubmodule" />
        <synthea:SubmoduleConfig submodule="medications/otc_pain_reliever" />
      </bpmn:extensionElements>
    </bpmn:callActivity>

    <!-- delay-requires-shape: stateType="Delay" with a delayShape -->
    <bpmn:intermediateCatchEvent id="Delay_Good" name="Delay (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Delay" />
        <synthea:DelayConfig delayShape="EXACT" delayValue="10" delayUnit="days" />
      </bpmn:extensionElements>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- encounter-reference-requires-condition-or-allergy-context: targetEncounter
         on a ConditionOnset state -->
    <bpmn:intermediateCatchEvent id="ConditionOnset_Good" name="Condition onset (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="ConditionOnset" />
        <synthea:EncounterReference targetEncounter="Encounter_1" />
      </bpmn:extensionElements>
    </bpmn:intermediateCatchEvent>

    <!-- wellness-consistent-within-encounter: two states sharing one encounterId
         agree on wellness (ADR-0003: encounter scope derived from EncounterContext,
         no explicit Encounter/EncounterEnd states) -->
    <bpmn:task id="EncounterA_Member1_Good" name="Encounter A member 1 (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
        <synthea:SetAttributeConfig attribute="last_encounter_note" />
        <synthea:EncounterContext requiresEncounterContext="true" encounterId="Encounter_A" wellness="true" />
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="EncounterA_Member2_Good" name="Encounter A member 2 (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
        <synthea:SetAttributeConfig attribute="last_encounter_note" />
        <synthea:EncounterContext requiresEncounterContext="true" encounterId="Encounter_A" wellness="true" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- encounter-class-consistent-within-encounter: non-wellness encounter with a
         consistent encounterClass set on both members -->
    <bpmn:task id="EncounterC_Member1_Good" name="Encounter C member 1 (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
        <synthea:SetAttributeConfig attribute="last_encounter_note" />
        <synthea:EncounterContext requiresEncounterContext="true" encounterId="Encounter_C" wellness="false" encounterClass="emergency" />
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="EncounterC_Member2_Good" name="Encounter C member 2 (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="SetAttribute" />
        <synthea:SetAttributeConfig attribute="last_encounter_note" />
        <synthea:EncounterContext requiresEncounterContext="true" encounterId="Encounter_C" wellness="false" encounterClass="emergency" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- probability-sum-valid: two probabilityAttribute-only flows must NOT
         count as "unfixed" (Table C: a named/dynamic distribution, not an
         omission) -->
    <bpmn:task id="Task_AttrBranch_Good" name="Attribute branch (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Simple" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Attr1</bpmn:outgoing>
      <bpmn:outgoing>Flow_Attr2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Attr1">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Terminal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Attr1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Attr2">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Terminal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Attr2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Attr1" sourceRef="Task_AttrBranch_Good" targetRef="EndEvent_Attr1">
      <bpmn:extensionElements>
        <synthea:ProbabilityConfig probabilityAttribute="p_attr_1" probabilityDefault="0.5" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Attr2" sourceRef="Task_AttrBranch_Good" targetRef="EndEvent_Attr2">
      <bpmn:extensionElements>
        <synthea:ProbabilityConfig probabilityAttribute="p_attr_2" probabilityDefault="0.5" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <!-- counter-requires-action: CounterConfig has both attribute and action -->
    <bpmn:task id="Task_Counter_Good" name="Counter (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Counter" />
        <synthea:CounterConfig attribute="chemo_cycles" action="increment" amount="1" />
      </bpmn:extensionElements>
    </bpmn:task>

    <!-- assign-to-attribute-requires-valid-state: attribute set on a ConditionOnset state -->
    <bpmn:intermediateCatchEvent id="ConditionOnset_AssignGood" name="Condition onset with assign (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="ConditionOnset" />
        <synthea:AssignToAttributeConfig attribute="lung_cancer_diagnosis_date" />
      </bpmn:extensionElements>
    </bpmn:intermediateCatchEvent>

    <!-- delay-range-requires-high-value: delayShape="RANGE" with both delayValue and delayValueHigh -->
    <bpmn:intermediateCatchEvent id="Delay_Range_Good" name="Delay range (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Delay" />
        <synthea:DelayConfig delayShape="RANGE" delayValue="3" delayValueHigh="5" delayUnit="months" />
      </bpmn:extensionElements>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- referenced-by-attribute-requires-valid-state: attribute set on a Death state -->
    <bpmn:endEvent id="Death_ReferencedGood" name="Death (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Death" />
        <synthea:ReferencedByAttributeConfig attribute="lung_cancer_diagnosis_date" />
      </bpmn:extensionElements>
    </bpmn:endEvent>

    <!-- symptom-config / observation-config / value-config / imaging-study-series / encounter code: a complete example of each -->
    <bpmn:task id="Symptom_Good" name="Symptom (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Symptom" />
        <synthea:SymptomConfig symptom="Cough" />
        <synthea:ValueConfig valueShape="RANGE" value="50" valueHigh="100" />
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="Observation_Good" name="Observation (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Observation" />
        <synthea:ObservationConfig category="vital-signs" />
        <synthea:ValueConfig valueShape="RANGE" value="4" valueHigh="8" unit="{score}" decimals="0" />
        <synthea:EncounterContext requiresEncounterContext="true" encounterId="Encounter_CodeGood" wellness="false" encounterClass="emergency" encounterCodeSystem="http://snomed.info/sct" encounterCode="50849002" encounterCodeDisplay="Emergency room admission (procedure)" />
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="Imaging_Good" name="Imaging study with series (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="ImagingStudy" />
        <synthea:ImagingStudySeries bodySiteCode="51185008" bodySiteDisplay="Thoracic structure (body structure)" modalityCode="CT" modalityDisplay="Computed Tomography" instanceTitle="CT Image Storage" sopClassCode="1.2.840.10008.5.1.4.1.1.2" sopClassDisplay="CT Image Storage" minInstances="300" maxInstances="500" />
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="Procedure_Duration_Good" name="Procedure with duration (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Procedure" />
        <synthea:ValueConfig valueShape="RANGE" value="0.5" valueHigh="4" unit="hours" />
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="MedicationOrder_Administration_Good" name="Administered medication (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="MedicationOrder" />
        <synthea:MedicationConfig administration="true" />
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="CarePlan_Activities_Good" name="Care plan with activities (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="CarePlanStart" />
        <synthea:CarePlanActivity code="133918004" codeDisplay="Comfort measures (regime/therapy)" />
        <synthea:CarePlanActivity code="243072006" codeDisplay="Cancer education (procedure)" />
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="DiagnosticReport_Good" name="Lab panel with contained observations (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="DiagnosticReport" />
        <synthea:ReportObservation code="718-7" codeDisplay="Hemoglobin [Mass/volume] in Blood" category="laboratory" unit="g/dL" valueShape="RANGE" value="10" valueHigh="11.9" />
        <synthea:ReportObservation code="5767-9" codeDisplay="Appearance of Urine" category="laboratory" unit="{nominal}" valueCodeSystem="http://snomed.info/sct" valueCode="7766007" valueCodeDisplay="Cloudy urine (finding)" />
        <synthea:ReportObservation code="2339-0" codeDisplay="Glucose [Mass/volume] in Blood" category="laboratory" unit="mg/dL" vitalSign="Glucose" />
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:intermediateThrowEvent id="Death_TimeSpanGood" name="Death with a time span (good)">
      <bpmn:extensionElements>
        <synthea:StateTypeConfig stateType="Death" />
        <synthea:ValueConfig valueShape="RANGE" value="2" valueHigh="6" unit="years" />
      </bpmn:extensionElements>
    </bpmn:intermediateThrowEvent>

  </bpmn:process>
</bpmn:definitions>
