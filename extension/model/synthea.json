{
  "name": "Synthea",
  "uri": "https://forschungsgruppe-digital-health.github.io/schema/synthea/1.0",
  "prefix": "synthea",
  "version": "0.1.0",
  "xml": { "tagAlias": "lowerCase" },
  "types": [
    { "name": "DelayShape", "isEnum": true, "literalValues": [
      {"name": "EXACT"}, {"name": "RANGE"}
    ]},
    { "name": "DelayConfig", "superClass": ["Element"], "properties": [
      { "name": "delayShape", "type": "DelayShape", "isAttr": true },
      { "name": "delayValue", "type": "String", "isAttr": true },
      { "name": "delayValueHigh", "type": "String", "isAttr": true },
      { "name": "delayUnit", "type": "String", "isAttr": true }
    ]},
    { "name": "ConditionType", "isEnum": true, "literalValues": [
      {"name": "Attribute"}, {"name": "Gender"}, {"name": "Race"}, {"name": "Socioeconomic Status"},
      {"name": "Age"}, {"name": "Date"}, {"name": "Symptom"}, {"name": "Observation"}, {"name": "Vital Sign"},
      {"name": "Active Condition"}, {"name": "Active Medication"}, {"name": "Active Allergy"}, {"name": "Active CarePlan"},
      {"name": "PriorState"}, {"name": "True"}, {"name": "False"},
      {"name": "And"}, {"name": "Or"}, {"name": "At Least"}, {"name": "At Most"}
    ]},
    { "name": "Condition", "superClass": ["Element"], "properties": [
      { "name": "conditionType", "type": "ConditionType", "isAttr": true },
      { "name": "attribute", "type": "String", "isAttr": true },
      { "name": "operator", "type": "String", "isAttr": true },
      { "name": "value", "type": "String", "isAttr": true },
      { "name": "negate", "type": "Boolean", "isAttr": true, "default": false },
      { "name": "gender", "type": "String", "isAttr": true },
      { "name": "race", "type": "String", "isAttr": true },
      { "name": "category", "type": "String", "isAttr": true },
      { "name": "quantity", "type": "Real", "isAttr": true },
      { "name": "unit", "type": "String", "isAttr": true },
      { "name": "year", "type": "Integer", "isAttr": true },
      { "name": "month", "type": "Integer", "isAttr": true },
      { "name": "symptom", "type": "String", "isAttr": true },
      { "name": "vitalSign", "type": "String", "isAttr": true },
      { "name": "referencedAttribute", "type": "String", "isAttr": true },
      { "name": "priorStateName", "type": "String", "isAttr": true },
      { "name": "since", "type": "String", "isAttr": true },
      { "name": "minimum", "type": "Integer", "isAttr": true },
      { "name": "maximum", "type": "Integer", "isAttr": true },
      { "name": "conditions", "type": "Condition", "isMany": true }
    ]},
    { "name": "GuardConfig", "superClass": ["Element"], "properties": [
      { "name": "allow", "type": "Condition" }
    ]},
    { "name": "SubmoduleConfig", "superClass": ["Element"], "properties": [
      { "name": "submodule", "type": "String", "isAttr": true }
    ]},
    { "name": "ProbabilityConfig", "superClass": ["Element"], "properties": [
      { "name": "probability", "type": "Real", "isAttr": true },
      { "name": "probabilityAttribute", "type": "String", "isAttr": true },
      { "name": "probabilityDefault", "type": "Real", "isAttr": true }
    ]},
    { "name": "EncounterClass", "isEnum": true, "literalValues": [
      {"name": "wellness"}, {"name": "ambulatory"}, {"name": "emergency"}, {"name": "urgentcare"}, {"name": "inpatient"}, {"name": "outpatient"}
    ]},
    { "name": "EncounterContext", "superClass": ["Element"], "properties": [
      { "name": "requiresEncounterContext", "type": "Boolean", "isAttr": true, "default": false },
      { "name": "encounterId", "type": "String", "isAttr": true },
      { "name": "wellness", "type": "Boolean", "isAttr": true, "default": false },
      { "name": "encounterClass", "type": "EncounterClass", "isAttr": true },
      { "name": "reason", "type": "String", "isAttr": true }
    ]},
    { "name": "EncounterReference", "superClass": ["Element"], "properties": [
      { "name": "targetEncounter", "type": "String", "isAttr": true }
    ]},
    { "name": "CounterAction", "isEnum": true, "literalValues": [
      {"name": "increment"}, {"name": "decrement"}
    ]},
    { "name": "CounterConfig", "superClass": ["Element"], "properties": [
      { "name": "attribute", "type": "String", "isAttr": true },
      { "name": "action", "type": "CounterAction", "isAttr": true },
      { "name": "amount", "type": "Real", "isAttr": true }
    ]},
    { "name": "SetAttributeConfig", "superClass": ["Element"], "properties": [
      { "name": "attribute", "type": "String", "isAttr": true },
      { "name": "value", "type": "String", "isAttr": true }
    ]},
    { "name": "AssignToAttributeConfig", "superClass": ["Element"], "properties": [
      { "name": "attribute", "type": "String", "isAttr": true }
    ]},
    { "name": "ReferencedByAttributeConfig", "superClass": ["Element"], "properties": [
      { "name": "attribute", "type": "String", "isAttr": true }
    ]},
    { "name": "StateType", "isEnum": true, "literalValues": [
      { "name": "Initial" }, { "name": "Terminal" }, { "name": "Simple" }, { "name": "Guard" },
      { "name": "Delay" }, { "name": "SetAttribute" }, { "name": "Counter" }, { "name": "CallSubmodule" },
      { "name": "ConditionOnset" }, { "name": "ConditionEnd" },
      { "name": "AllergyOnset" }, { "name": "AllergyEnd" }, { "name": "MedicationOrder" }, { "name": "MedicationEnd" },
      { "name": "CarePlanStart" }, { "name": "CarePlanEnd" }, { "name": "Procedure" }, { "name": "ImagingStudy" },
      { "name": "Device" }, { "name": "DeviceEnd" }, { "name": "SupplyList" }, { "name": "VitalSign" },
      { "name": "Observation" }, { "name": "MultiObservation" }, { "name": "DiagnosticReport" }, { "name": "Symptom" },
      { "name": "Death" }, { "name": "Physiology" }
    ]},
    { "name": "StateTypeConfig", "superClass": ["Element"], "properties": [
      { "name": "stateType", "type": "StateType", "isAttr": true }
    ]},
    { "name": "ConditionConfig", "superClass": ["Element"], "properties": [
      { "name": "condition", "type": "Condition" }
    ]}
  ]
}
