      { "name": "modalityDisplay", "type": "String", "isAttr": true },
      { "name": "instanceTitle", "type": "String", "isAttr": true },
      { "name": "sopClassCode", "type": "String", "isAttr": true },
      { "name": "sopClassDisplay", "type": "String", "isAttr": true },
      { "name": "minInstances", "type": "Integer", "isAttr": true },
      { "name": "maxInstances", "type": "Integer", "isAttr": true }
