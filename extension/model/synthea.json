      { "name": "code", "type": "String", "isAttr": true },
      { "name": "codeDisplay", "type": "String", "isAttr": true },
      { "name": "category", "type": "ObservationCategory", "isAttr": true },
      { "name": "unit", "type": "String", "isAttr": true },
      { "name": "valueShape", "type": "ValueShape", "isAttr": true },
      { "name": "value", "type": "Real", "isAttr": true },
      { "name": "valueHigh", "type": "Real", "isAttr": true },
      { "name": "decimals", "type": "Integer", "isAttr": true },
      { "name": "valueCodeSystem", "type": "String", "isAttr": true },
      { "name": "valueCode", "type": "String", "isAttr": true },
      { "name": "valueCodeDisplay", "type": "String", "isAttr": true },
      { "name": "vitalSign", "type": "String", "isAttr": true }
    ]},
    { "name": "ConditionConfig", "superClass": ["Element"], "properties": [
      { "name": "condition", "type": "Condition" }
    ]}
