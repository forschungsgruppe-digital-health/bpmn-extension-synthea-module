      { "name": "distributionMean", "type": "Real", "isAttr": true },
      { "name": "distributionStandardDeviation", "type": "Real", "isAttr": true },
      { "name": "distributionMin", "type": "Real", "isAttr": true },
      { "name": "distributionMax", "type": "Real", "isAttr": true },
      { "name": "distributionLow", "type": "Real", "isAttr": true },
      { "name": "distributionHigh", "type": "Real", "isAttr": true }
