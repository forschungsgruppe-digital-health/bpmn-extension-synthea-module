    "Hematocrit critical?": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Observation",
                "codes": [
                  {
                    "system": "LOINC",
                    "code": "20570-8",
                    "display": "Hematocrit [Volume Fraction] of Blood by calculation"
                  }
                ],
                "operator": "<=",
                "value": 28
              },
              {
                "condition_type": "Gender",
                "gender": "F"
              }
            ]
          },
          "transition": "Delay: 1 hour"
        },
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Gender",
                "gender": "M"
              },
              {
                "condition_type": "Observation",
                "codes": [
                  {
                    "system": "LOINC",
                    "code": "20570-8",
                    "display": "Hematocrit [Volume Fraction] of Blood by calculation"
                  }
                ],
                "operator": "<=",
                "value": 27
              }
            ]
          },
          "transition": "Delay: 1 hour"
        },
        {
          "transition": "Administer_Medications"
        }
      ]
    },
